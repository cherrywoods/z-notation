{
  "id": "bank-account",
  "revision": 2,
  "title": "Bank Accounts",
  "short": "Bank Accounts",
  "icon": "landmark",
  "description": "Bank accounts with owners, balances and overdraft limits.",
  "card": [
    "Each account has an owner, a balance and an overdraft limit.",
    "The limit says how far the balance may drop below zero.",
    "A withdrawal that would go past the limit has to be refused.",
    "Only the owner may see an account's balance."
  ],
  "typesPrompt": "The bank deals with accounts and the people who own them.",
  "requirements": [
    { "id": "R1", "text": "Each open account has one owner, a balance and a non-negative overdraft limit (in euros)." },
    { "id": "R2", "text": "No account may be overdrawn by more than its overdraft limit." },
    { "id": "R3", "text": "Initially, no accounts are open." },
    { "id": "R4", "text": "Only the owner of an account may query its balance." },
    { "id": "R5", "text": "The owner of an account can withdraw a positive amount from it." }
  ],
  "givenSets": [
    {
      "name": "ACCOUNT",
      "values": ["DE4711", "DE0815", "DE1234", "DE2024", "DE3141", "DE2718", "DE1001", "DE9999"],
      "infinite": true
    },
    { "name": "PERSON", "values": ["Mia", "Noah", "Lea", "Paul", "Emma", "Jonas", "Hanna", "Luis"], "infinite": true }
  ],
  "typeOptions": [
    { "name": "BRANCH", "values": ["Konstanz", "Zurich", "Munich", "Berlin", "Vienna", "Basel"], "infinite": true },
    { "name": "CURRENCY", "values": ["EUR", "CHF", "USD", "GBP", "JPY", "SEK"] },
    {
      "name": "DATE",
      "values": ["2.Feb", "17.Apr", "8.Jun", "23.Jul", "5.Sep", "11.Nov", "29.Jan", "14.Mar"],
      "infinite": true
    }
  ],
  "goals": {
    "types": [
      { "text": "A type for accounts", "check": { "given": "ACCOUNT" } },
      { "text": "A type for people", "check": { "given": "PERSON" } }
    ],
    "state": [
      { "text": "Who owns each account", "check": { "var": "owner" } },
      { "text": "The balance and overdraft limit of each account", "check": { "var": ["balance", "overdraft"] } },
      {
        "text": "Each account has only one owner",
        "check": { "holds": "∀ a ∈ dom owner; p₁, p₂ ∈ ran owner . (a ↦ p₁) ∈ owner ∧ (a ↦ p₂) ∈ owner ⇒ p₁ = p₂" }
      },
      {
        "text": "Every open account has a balance and a limit",
        "check": { "holds": "dom balance = dom owner ∧ dom overdraft = dom owner" }
      },
      {
        "text": "No account is overdrawn beyond its limit",
        "check": { "holds": "∀ a ∈ dom balance . balance(a) ≥ -overdraft(a)" }
      }
    ],
    "init": [
      { "text": "No open accounts at the start", "check": { "holds": "owner = ∅" } },
      { "text": "No balances or limits at the start", "check": { "holds": "balance = ∅ ∧ overdraft = ∅" } }
    ],
    "ops": {
      "QueryBalance": [
        { "text": "Take a person and an account, output a balance", "check": { "var": ["p?", "a?", "b!"] } },
        { "text": "Only for open accounts", "check": { "holds": "a? ∈ dom owner" } },
        { "text": "Only the owner may ask", "check": { "holds": "(a? ↦ p?) ∈ owner" } },
        { "text": "Output the account's balance", "check": { "holds": "(a? ↦ b!) ∈ balance" } },
        {
          "text": "Don't change anything",
          "check": { "holds": "owner′ = owner ∧ balance′ = balance ∧ overdraft′ = overdraft" }
        }
      ],
      "Withdraw": [
        { "text": "Take a person, an account and an amount as inputs", "check": { "var": ["p?", "a?", "amount?"] } },
        { "text": "Only the owner may withdraw", "check": { "holds": "(a? ↦ p?) ∈ owner" } },
        { "text": "Stay within the overdraft limit", "check": { "holds": "balance(a?) - amount? ≥ -overdraft(a?)" } },
        {
          "text": "Take the amount off the balance",
          "check": { "holds": "balance′ = (balance ∖ {a? ↦ balance(a?)}) ∪ {a? ↦ balance(a?) - amount?}" }
        },
        { "text": "Leave owners and limits unchanged", "check": { "holds": "owner′ = owner ∧ overdraft′ = overdraft" } }
      ]
    }
  },
  "state": {
    "invariantPrompt": "No account may be overdrawn beyond its overdraft limit.",
    "name": "Bank",
    "prompt": "Each account's owner, balance and overdraft limit. No account may be overdrawn beyond its limit.",
    "declarations": [
      { "text": "owner : ACCOUNT ⇸ PERSON", "requirements": ["R1"] },
      { "text": "balance : ACCOUNT ⇸ ℤ", "requirements": ["R1"] },
      { "text": "overdraft : ACCOUNT ⇸ ℕ", "requirements": ["R1"] }
    ],
    "predicates": [
      { "text": "dom balance = dom owner", "requirements": ["R1"] },
      { "text": "dom overdraft = dom owner", "requirements": ["R1"] },
      { "text": "∀ a ∈ dom balance . balance(a) ≥ -overdraft(a)", "requirements": ["R2"], "hidden": true }
    ]
  },
  "init": {
    "name": "InitBank",
    "prompt": "At the start, no accounts are open.",
    "declarations": [
      { "text": "Bank", "requirements": [] }
    ],
    "predicates": [
      { "text": "owner = ∅", "requirements": ["R3"] }
    ]
  },
  "operations": [
    {
      "name": "QueryBalance",
      "kind": "query",
      "prompt": "Show an account's balance, but only to its owner.",
      "declarations": [
        { "text": "ΞBank", "requirements": [] },
        { "text": "p? : PERSON", "requirements": ["R4"] },
        { "text": "a? : ACCOUNT", "requirements": ["R4"] },
        { "text": "b! : ℤ", "requirements": ["R4"] }
      ],
      "predicates": [
        { "text": "a? ∈ dom owner", "requirements": ["R4"] },
        { "text": "owner(a?) = p?", "requirements": ["R4"], "hidden": true },
        { "text": "b! = balance(a?)", "requirements": ["R4"] }
      ]
    },
    {
      "name": "Withdraw",
      "kind": "update",
      "prompt": "Let the owner withdraw money, but never beyond the overdraft limit.",
      "declarations": [
        { "text": "ΔBank", "requirements": [] },
        { "text": "p? : PERSON", "requirements": ["R5"] },
        { "text": "a? : ACCOUNT", "requirements": ["R5"] },
        { "text": "amount? : ℕ₁", "requirements": ["R5"] }
      ],
      "predicates": [
        { "text": "a? ∈ dom owner", "requirements": ["R5"] },
        { "text": "owner(a?) = p?", "requirements": ["R5"] },
        { "text": "balance(a?) - amount? ≥ -overdraft(a?)", "requirements": ["R2"], "hidden": true },
        { "text": "balance′ = (balance ∖ {a? ↦ balance(a?)}) ∪ {a? ↦ balance(a?) - amount?}", "requirements": ["R5"] },
        { "text": "owner′ = owner", "requirements": [] },
        { "text": "overdraft′ = overdraft", "requirements": [] }
      ]
    }
  ],
  "extraOperations": [
    {
      "name": "OpenAccount",
      "kind": "update",
      "declarations": [
        { "text": "ΔBank", "requirements": [] },
        { "text": "p? : PERSON", "requirements": ["R1"] },
        { "text": "limit? : ℕ", "requirements": ["R1"] },
        { "text": "a! : ACCOUNT", "requirements": ["R1"] }
      ],
      "predicates": [
        { "text": "a! ∉ dom owner", "requirements": ["R1"] },
        { "text": "owner′ = owner ∪ {a! ↦ p?}", "requirements": ["R1"] },
        { "text": "balance′ = balance ∪ {a! ↦ 0}", "requirements": ["R1"] },
        { "text": "overdraft′ = overdraft ∪ {a! ↦ limit?}", "requirements": ["R1"] }
      ]
    },
    {
      "name": "Deposit",
      "kind": "update",
      "declarations": [
        { "text": "ΔBank", "requirements": [] },
        { "text": "a? : ACCOUNT", "requirements": [] },
        { "text": "amount? : ℕ₁", "requirements": [] }
      ],
      "predicates": [
        { "text": "a? ∈ dom owner", "requirements": [] },
        { "text": "balance′ = (balance ∖ {a? ↦ balance(a?)}) ∪ {a? ↦ balance(a?) + amount?}", "requirements": [] },
        { "text": "owner′ = owner", "requirements": [] },
        { "text": "overdraft′ = overdraft", "requirements": [] }
      ]
    },
    {
      "name": "Transfer",
      "kind": "update",
      "declarations": [
        { "text": "ΔBank", "requirements": [] },
        { "text": "p? : PERSON", "requirements": [] },
        { "text": "from? : ACCOUNT", "requirements": [] },
        { "text": "to? : ACCOUNT", "requirements": [] },
        { "text": "amount? : ℕ₁", "requirements": [] }
      ],
      "predicates": [
        { "text": "from? ∈ dom owner", "requirements": [] },
        { "text": "owner(from?) = p?", "requirements": [] },
        { "text": "to? ∈ dom owner", "requirements": [] },
        { "text": "from? ≠ to?", "requirements": [] },
        { "text": "balance(from?) - amount? ≥ -overdraft(from?)", "requirements": ["R2"] },
        {
          "text": "balance′ = (balance ∖ {from? ↦ balance(from?), to? ↦ balance(to?)}) ∪ {from? ↦ balance(from?) - amount?, to? ↦ balance(to?) + amount?}",
          "requirements": []
        },
        { "text": "owner′ = owner", "requirements": [] },
        { "text": "overdraft′ = overdraft", "requirements": [] }
      ]
    }
  ]
}
