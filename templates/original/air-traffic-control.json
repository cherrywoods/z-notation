    },
    {
      "name": "NoClearance",
      "kind": "error",
      "requirements": ["R12"],
      "declarations": [
        { "include": "ΞAirTraffic" },
        { "name": "a?", "type": "AIRCRAFT" },
        { "name": "r!", "type": "REPORT" }
      ],
      "predicates": [
        { "formula": "a? ∉ dom landing" },
        { "formula": "r! = noClearance" }
      ]
    }
  ],
  "schemaDefinitions": [
    { "name": "SignOnTotal", "expression": "(SignOn ∧ Success) ∨ AlreadyOnDuty", "requirements": ["R3", "R12"] },
    { "name": "SignOffTotal", "expression": "(SignOff ∧ Success) ∨ NotOnDuty ∨ StillControlling", "requirements": ["R3", "R12"] },
    { "name": "EnterAirspaceTotal", "expression": "(EnterAirspace ∧ Success) ∨ AlreadyTracked ∨ NotOnDuty", "requirements": ["R4", "R12"] },
    { "name": "HandoverTotal", "expression": "(Handover ∧ Success) ∨ NotTracked ∨ NotOnDuty ∨ SameController ∨ AlreadyCleared ∨ OnRunway", "requirements": ["R5", "R12"] },
    { "name": "ClearToLandTotal", "expression": "(ClearToLand ∧ Success) ∨ NotTracked ∨ NotYourAircraft ∨ WrongSector ∨ AlreadyCleared ∨ OnRunway ∨ RunwayOccupied ∨ RunwayReserved", "requirements": ["R7", "R8", "R12"] },
    { "name": "CancelLandingTotal", "expression": "(CancelLanding ∧ Success) ∨ NoClearance", "requirements": ["R9", "R12"] },
    { "name": "LineUpTotal", "expression": "(LineUp ∧ Success) ∨ AlreadyTracked ∨ NotOnDuty ∨ WrongTowerController ∨ RunwayOccupied ∨ RunwayReserved", "requirements": ["R11", "R12"] }
  ]
}
