        { "name": "a?", "type": "AIRCRAFT" },
        { "name": "r?", "type": "RUNWAY" },
        { "name": "r!", "type": "REPORT" }
      ],
      "predicates": [
        { "formula": "a? ∈ dom sectorOf" },
        { "formula": "sectorOf a? ≠ runwaySector r?" },
        { "formula": "r! = wrongSector" }
