      "declarations": [
        { "include": "ΞAirTraffic" },
        { "name": "a?", "type": "AIRCRAFT" },
        { "name": "c?", "type": "CONTROLLER" },
        { "name": "r!", "type": "REPORT" }
      ],
      "predicates": [
        { "formula": "a? ∈ dom control" },
        { "formula": "control a? ≠ c?" },
        { "formula": "r! = notYourAircraft" }
      ]
    },
    {
      "name": "WrongSector",
      "kind": "error",
