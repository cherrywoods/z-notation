    },
    {
      "name": "NotTracked",
      "kind": "error",
      "requirements": ["R12"],
      "declarations": [
        { "include": "ΞAirTraffic" },
        { "name": "a?", "type": "AIRCRAFT" },
        { "name": "r!", "type": "REPORT" }
      ],
      "predicates": [
        { "formula": "a? ∉ dom sectorOf" },
        { "formula": "r! = notTracked" }
      ]
    },
    {
      "name": "SameController",
      "kind": "error",
      "requirements": ["R12"],
      "declarations": [
        { "include": "ΞAirTraffic" },
        { "name": "a?", "type": "AIRCRAFT" },
        { "name": "c?", "type": "CONTROLLER" },
        { "name": "r!", "type": "REPORT" }
      ],
      "predicates": [
        { "formula": "a? ∈ dom control" },
        { "formula": "control a? = c?" },
        { "formula": "r! = sameController" }
      ]
    },
    {
